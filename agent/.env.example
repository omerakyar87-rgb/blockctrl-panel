# Required agent identity
PANEL_URL=https://YOUR-PANEL.example.com
NODE_ID=YOUR_NODE_ID
NODE_TOKEN=YOUR_NODE_TOKEN
DATA_DIR=/srv/blockctrl


# Website account bridge used by tracker/mod /register -> agent -> panel server-provision.
# Must match BLOCKCTRL_SITE_SERVER_BRIDGE_KEY on the panel. Keep this server-side only.
BLOCKCTRL_SITE_SERVER_BRIDGE_KEY=


# Optional agent download listener
# AGENT_DOWNLOAD_HOST=0.0.0.0
# AGENT_DOWNLOAD_PORT=8789


# Optional database administration integration
# DB_ADMIN_HOST=127.0.0.1
# DB_ADMIN_PORT=5432
# DB_ADMIN_USER=postgres
# DB_ADMIN_PASSWORD=
# DB_CLIENT=psql
# DB_PORT=5432


# BlockCtrl server adapter artifacts. These provide website /register and, when enabled, lost-item tracking.
# Prefer the versioned directory layout:
#   /srv/blockctrl/trackers/<loader>/<minecraft-version>/blockctrl-tracker.jar
# BLOCKCTRL_TRACKER_DIR=/srv/blockctrl/trackers
# PAPER_TRACKER_JAR=
# TRACKER_JAR= # legacy Paper alias
# FABRIC_TRACKER_JAR=
# FORGE_TRACKER_JAR=
# NEOFORGE_TRACKER_JAR=


# Optional anticheat / world template artifacts
# BLOCKCTRL_ANTICHEAT_JAR=
# BLOCKCTRL_ANTICHEAT_SHA256=
# BLOCKCTRL_ANTICHEAT_MOD_JAR=
# BLOCKCTRL_ANTICHEAT_MOD_SHA256=
# BLOCKCTRL_WORLD_TEMPLATE_DIR=