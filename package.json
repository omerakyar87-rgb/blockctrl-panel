{
  "name": "blockctrl-panel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.ts --auto && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "agent:dev": "pnpm --dir agent dev",
    "agent:build": "pnpm --dir agent build",
    "agent:start": "pnpm --dir agent start",
    "test:contracts": "node scripts/check-contracts.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test": "pnpm test:contracts && pnpm test:unit"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "@vercel/analytics": "1.6.1",
    "@vercel/blob": "^2.8.0",
    "better-auth": "1.6.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.3.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.70.0"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25"
    }
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.34.5"
}
